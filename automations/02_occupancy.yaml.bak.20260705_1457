# Kitchen Occupancy Lighting — Tuya Human Presence Sensor (simplified)
# Primary: input_boolean.kitchen_tuya_presence (detects stationary humans)
# ON → ambient lights. If dark/cloudy + NOT quiet hours → add bright lights.
# OFF for 3 min → all off. Manual off → 15-min cooldown.
# Quiet hours (midnight→sunrise): ambient only, no bright lights.
# Removed: watchdog, occupied_recovery, presence_3 triggers, gpio triggers.
- id: downstairs_occupancy_lighting
  alias: Downstairs Occupancy Lighting
  description: >
    Tuya Human Presence Sensor drives kitchen lights. ON → ambient +
    conditional bright. OFF 3 min → all off. Manual off → 15-min cooldown.
    Quiet hours (midnight→sunrise): ambient only.
  mode: queued
  max: 10
  max_exceeded: silent
  trigger:
    - id: occupied
      platform: state
      entity_id: input_boolean.kitchen_tuya_presence
      to: "on"
    - id: unoccupied
      platform: state
      entity_id: input_boolean.kitchen_tuya_presence
      to: "off"
      for:
        minutes: 3
    - id: manual_off
      platform: state
      entity_id: light.kitchen_light_light_1
      to: "off"
    - id: ha_start
      platform: homeassistant
      event: start
  condition: []
  action:
    - choose:
        # ── Occupied: Tuya presence detected ──────────────────────────
        - conditions:
            - condition: trigger
              id: occupied
            - condition: not
              conditions:
                - condition: state
                  entity_id: timer.kitchen_manual_cooldown
                  state: active
            - condition: state
              entity_id: input_boolean.kitchen_tuya_presence
              state: "on"
          sequence:
            # Ambient: cabinet strips + nanoleafs (always on when occupied)
            - action: light.turn_on
              target:
                entity_id:
                  - light.cabinet_light_strip_left_nanoleaf_light_strip
                  - light.cabinet_light_strip_center_nanoleaf_light_strip
                  - light.cabinet_light_strip_right_nanoleaf_light_strip
              data:
                brightness_pct: 100
                transition: 1
              continue_on_error: true
            - action: light.turn_on
              target:
                entity_id:
                  - light.nanoleaf_multicolor_ls
                  - light.nanoleaf_multicolor_ls_2
              data:
                brightness_pct: 100
                transition: 1
              continue_on_error: true
            # Bright lights: only when dark/cloudy AND not quiet hours
            - if:
                - condition: not
                  conditions:
                    - condition: template
                      value_template: >
                        {% set nr = state_attr('sun.sun', 'next_rising') | as_datetime | as_local %}
                        {{ now() < nr and now().date() == nr.date() }}
                - condition: or
                  conditions:
                    - condition: state
                      entity_id: sun.sun
                      state: below_horizon
                    - condition: template
                      value_template: >
                        {{ state_attr('sun.sun', 'elevation') | float(0) < 10 }}
                    - condition: state
                      entity_id: weather.forecast_home
                      state:
                        - cloudy
                        - rainy
                        - snowy
                        - fog
                        - overcast
                        - partlycloudy
              then:
                - action: light.turn_on
                  target:
                    entity_id:
                      - light.kitchen_light_light_1
                      - light.island_light_light
                  data:
                    brightness_pct: 100
                  continue_on_error: true
                - action: switch.turn_on
                  target:
                    entity_id: switch.kitchen_pantry_light
                  continue_on_error: true

        # ── Unoccupied: no presence for 3 minutes ─────────────────────
        - conditions:
            - condition: trigger
              id: unoccupied
            - condition: state
              entity_id: timer.kitchen_manual_cooldown
              state: idle
            - condition: state
              entity_id: input_boolean.kitchen_tuya_presence
              state: "off"
          sequence:
            - action: timer.cancel
              target:
                entity_id: timer.kitchen_manual_cooldown
            - action: light.turn_off
              target:
                entity_id:
                  - light.kitchen_light_light_1
                  - light.island_light_light
                  - light.cabinet_light_strip_left_nanoleaf_light_strip
                  - light.cabinet_light_strip_center_nanoleaf_light_strip
                  - light.cabinet_light_strip_right_nanoleaf_light_strip
                  - light.nanoleaf_multicolor_ls
                  - light.nanoleaf_multicolor_ls_2
              continue_on_error: true
            - action: switch.turn_off
              target:
                entity_id: switch.kitchen_pantry_light
              continue_on_error: true

        # ── Manual Off: user turned off kitchen light ─────────────────
        - conditions:
            - condition: trigger
              id: manual_off
            - condition: template
              value_template: "{{ trigger.to_state.context.parent_id is none }}"
          sequence:
            - action: timer.start
              target:
                entity_id: timer.kitchen_manual_cooldown
              data:
                duration: "00:15:00"
            - action: light.turn_off
              target:
                entity_id:
                  - light.kitchen_light_light_1
                  - light.island_light_light
                  - light.cabinet_light_strip_left_nanoleaf_light_strip
                  - light.cabinet_light_strip_center_nanoleaf_light_strip
                  - light.cabinet_light_strip_right_nanoleaf_light_strip
                  - light.nanoleaf_multicolor_ls
                  - light.nanoleaf_multicolor_ls_2
              continue_on_error: true
            - action: switch.turn_off
              target:
                entity_id: switch.kitchen_pantry_light
              continue_on_error: true

        # ── HA Start: restore light state on restart ──────────────────
        - conditions:
            - condition: trigger
              id: ha_start
          sequence:
            - if:
                - condition: state
                  entity_id: input_boolean.kitchen_tuya_presence
                  state: "on"
              then:
                - action: light.turn_on
                  target:
                    entity_id:
                      - light.cabinet_light_strip_left_nanoleaf_light_strip
                      - light.cabinet_light_strip_center_nanoleaf_light_strip
                      - light.cabinet_light_strip_right_nanoleaf_light_strip
                      - light.nanoleaf_multicolor_ls
                      - light.nanoleaf_multicolor_ls_2
                  data:
                    brightness_pct: 100
                  continue_on_error: true
              else:
                - action: light.turn_off
                  target:
                    entity_id:
                      - light.kitchen_light_light_1
                      - light.island_light_light
                      - light.cabinet_light_strip_left_nanoleaf_light_strip
                      - light.cabinet_light_strip_center_nanoleaf_light_strip
                      - light.cabinet_light_strip_right_nanoleaf_light_strip
                      - light.nanoleaf_multicolor_ls
                      - light.nanoleaf_multicolor_ls_2
                  continue_on_error: true
            - action: switch.turn_off
              target:
                entity_id: switch.kitchen_pantry_light
              continue_on_error: true