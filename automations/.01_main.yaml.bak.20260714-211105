- id: low_battery_alert
  alias: Low Battery Alert - Daily
  description: Daily check of all battery sensors and alert if any are below 20%.
  mode: single
  triggers:
  - at: 09:00:00
    trigger: time
  conditions: []
  actions:
  - variables:
      low_batteries: |-
        {% set sensors = [
          'sensor.front_door_battery',
          'sensor.front_door_battery_2',
          'sensor.garages_entry_door_battery',
          'sensor.airbnb_battery',
          'sensor.airbnb_door_battery',
          'sensor.basement_battery',
          'sensor.basement_bathroom_leak_sensor_battery',
          'sensor.ensuite_leak_sensor_battery',
          'sensor.guest_bathroom_leak_sensor_battery',
          'sensor.kitchen_leak_sensor_battery',
          'sensor.laundry_room_leak_sensor_battery',
          'sensor.powder_room_leak_sensor_battery',
          'sensor.sump_pump_leak_sensor_battery',
          'sensor.izaans_room_battery',
          'sensor.minas_room_battery',
          'sensor.cat_feeder_battery'
        ] %} {% set ns = namespace(low=[]) %} {% for s in sensors %}
          {% set val = states(s) | int(-1) %}
          {% if val >= 0 and val < 20 %}
            {% set ns.low = ns.low + [s ~ ' (' ~ val ~ '%)'] %}
          {% endif %}
        {% endfor %} {{ ns.low | join(', ') }}
  - condition: template
    value_template: '{{ low_batteries | length > 0 }}'
  - action: notify.mobile_app_cph2655
    data:
      message: 'Low battery alert: {{ low_batteries }}'
      title: 🔋 Low Battery Alert
- id: office_heater_smart_control
  alias: Office Heater Smart Control
  description: 'Heats the office (climate.office_heater_2) to 21°C while the office mmWave sees someone AND the room is below 20°C (the cold trigger also re-heats during continuous occupancy); off after 30 min empty or once the room passes 23°C. Blocked while house_away is on — the mmWave is cat-trippable and away-mode owns the heater then. Fixed 2026-07-10: previous version read the Pi CPU temperature as the room temp and toggled the child-lock switch instead of the heater.'
  mode: single
  triggers:
  - entity_id: binary_sensor.usb_c_mmwave_sensor_presence
    to: 'on'
    id: occupied
    trigger: state
  - entity_id: binary_sensor.usb_c_mmwave_sensor_presence
    to: 'off'
    for:
      minutes: 30
    id: unoccupied
    trigger: state
  - trigger: numeric_state
    entity_id: climate.office_heater_2
    attribute: current_temperature
    above: 23
    id: warm_enough
  - trigger: numeric_state
    entity_id: climate.office_heater_2
    attribute: current_temperature
    below: 20
    id: cold
  conditions: []
  actions:
  - choose:
    - conditions:
      - condition: trigger
        id:
        - occupied
        - cold
      - condition: state
        entity_id: binary_sensor.usb_c_mmwave_sensor_presence
        state: 'on'
      - condition: numeric_state
        entity_id: climate.office_heater_2
        attribute: current_temperature
        below: 20
      - condition: state
        entity_id: input_boolean.house_away
        state: 'off'
      sequence:
      - action: climate.set_hvac_mode
        target:
          entity_id: climate.office_heater_2
        data:
          hvac_mode: heat
      - action: climate.set_temperature
        target:
          entity_id: climate.office_heater_2
        data:
          temperature: 21
    - conditions:
      - condition: trigger
        id:
        - unoccupied
        - warm_enough
      sequence:
      - action: climate.set_hvac_mode
        target:
          entity_id: climate.office_heater_2
        data:
          hvac_mode: 'off'
