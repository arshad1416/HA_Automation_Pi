          "state": "stopped",
          "script_execution": "finished",
          "timestamp": {
            "start": "2026-07-26T07:00:00.264642+00:00",
            "finish": "2026-07-26T07:00:00.273392+00:00"
          },
          "domain": "automation",
          "item_id": "climate_season_switch",
          "trigger": "time",
          "trace": {
            "trigger/0": [
              {
                "path": "trigger/0",
                "timestamp": "2026-07-26T07:00:00.264679+00:00",
                "changed_variables": {
                  "this": {
                    "entity_id": "automation.climate_season_switch",
                    "state": "on",
