              }
            ],
            "conditions": [],
            "actions": [
              {
                "if": [
                  {
                    "condition": "template",
                    "value_template": "{{ is_state('calendar.airbnb_ics','on') and 'reserved' in (state_attr('calendar.airbnb_ics','message') | string | lower) }}"
                  }
                ],
                "then": [
                  {
                    "action": "switch.turn_on",
                    "target": {
                      "entity_id": "switch.airbnb_reserved"
                    }
                  }
                ],
                "else": [
                  {
                    "action": "switch.turn_off",
                    "target": {
                      "entity_id": "switch.airbnb_reserved"
                    }
