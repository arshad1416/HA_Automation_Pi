            "action/6": [
              {
                "path": "action/6",
                "timestamp": "2026-07-26T04:30:14.422360+00:00",
                "result": {
                  "params": {
                    "domain": "notify",
                    "service": "mobile_app_cph2655",
                    "service_data": {
                      "message": "Bedtime routine ran (trigger: sleep_check, sleep_confidence 91). Locks: locking/locking, Garage: closed."
