          "config": {
            "id": "ev_phantom_drain_detection",
            "alias": "EV: Phantom drain detection",
            "description": "Every 6 h, if the car is home, not charging, and its SoC telemetry has been static for >24 h at a non-full level, nudge to check for phantom drain.",
            "mode": "single",
            "triggers": [
              {
                "trigger": "time_pattern",
                "hours": "/6"
              }
            ],
            "conditions": [
              {
                "condition": "state",
                "entity_id": "binary_sensor.grizzl_e_charging",
                "state": "off"
              },
              {
                "condition": "state",
                "entity_id": "device_tracker.ioniq_6_location",
                "state": "home"
              }
            ],
            "actions": [
              {
                "variables": {
                  "current_soc": "{{ states('sensor.ioniq_6_ev_battery_level') | default(0, true) | float(0) }}",
                  "soc_last_changed": "{{ states.sensor.ioniq_6_ev_battery_level.last_changed\n   if states.sensor.ioniq_6_ev_battery_level is defined else none }}\n"
                }
              },
              {
                "if": [
                  {
                    "condition": "template",
                    "value_template": "{{ current_soc > 0 and current_soc < 90 and soc_last_changed is not none\n   and (as_timestamp(now()) - as_timestamp(soc_last_changed)) > 86400 }}\n"
                  }
                ],
                "then": [
                  {
                    "action": "notify.mobile_app_cph2655",
                    "data": {
                      "title": "\ud83d\udd0b Possible Phantom Drain",
                      "message": "EV at {{ current_soc }}% and telemetry unchanged >24 h while parked. If SoC keeps dropping, check 12V battery or vampire loads."
                    }
                  }
                ]
              }
            ]
          },
          "blueprint_inputs": null,
          "context": {
            "id": "01KYG72BVRX8P8929MAKHC81FS",
            "parent_id": null,
            "user_id": null
          }
        },
        "short_dict": {
          "last_step": "condition/1/entity_id/0",
          "run_id": "b2f27a2dccf7f349a4c9a4137ab3f316",
          "state": "stopped",
