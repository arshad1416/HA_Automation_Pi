                }
              }
            ],
            "action/13/then/0": [
              {
                "path": "action/13/then/0",
                "timestamp": "2026-07-10T16:15:19.177045+00:00",
                "result": {
                  "params": {
                    "domain": "notify",
                    "service": "persistent_notification",
                    "service_data": {
                      "message": "Set: 22.5C Mode: cool Fans: kitchen=off, master=2, mina=1, guest=off, izaan=2 Vents: Iz=80% Mi=30% Blinds: {\"dining\":100,\"family\":100,\"living\":100,\"mina\":100} - It is a rainy, cloudy summer weekday afternoon during mid-peak rates. Cloud cover is above 40%, so blinds are kept fully open. Indoor perceived temperatures are near target. Ceiling fans are run in occupied/warm areas to assist cooling, and Izaan's vent booster is set to 80% to target its 22.8C temperature.",
                      "title": "Climate AI: 22.5C cool"
                    },
                    "target": {}
                  },
                  "running_script": false
                }
              }
            ],
            "action/14": [
              {
                "path": "action/14",
