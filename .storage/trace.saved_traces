    "automation.bedtime_routine_auto": [
      {
        "extended_dict": {
          "last_step": "condition/0/entity_id/0",
          "run_id": "b6371ffcc09140564b68a6ee178a145d",
          "state": "stopped",
          "script_execution": "failed_conditions",
          "timestamp": {
            "start": "2026-07-26T05:21:04.514982+00:00",
            "finish": "2026-07-26T05:21:04.515410+00:00"
          },
          "domain": "automation",
          "item_id": "bedtime_routine_auto",
          "trigger": "numeric state of sensor.cph2655_sleep_confidence",
          "trace": {
            "trigger/0": [
              {
                "path": "trigger/0",
                "timestamp": "2026-07-26T05:21:04.515113+00:00",
                "changed_variables": {
                  "this": {
                    "entity_id": "automation.bed_time_light_routine",
