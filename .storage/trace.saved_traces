          "config": {
            "id": "foyer_light_off_after_door_closed",
            "alias": "Foyer Light Daytime Auto-Off (door closed 30 min, or sun came out)",
            "description": "During the day, turn the foyer light off when ANY of these happen: the front door has stayed closed for 30 min; the UV index rises above 2; or it turns sunny out. The foyer is only turned ON on gloomy days, so it should switch off once it brightens or the door has been shut a while. Reliable replacement for the hallway-motion auto-off (foyer_light_daytime_auto_off), whose presence_3 mmWave is unavailable. The door-close timer resets if the door reopens; the UV/sunny triggers fire on the transition, so a foyer light manually switched on during an already-sunny day is left alone.",
            "mode": "single",
            "triggers": [
              {
                "trigger": "state",
                "entity_id": "binary_sensor.front_door_door",
                "to": "off",
                "for": {
                  "minutes": 30
                }
              },
              {
                "trigger": "numeric_state",
                "entity_id": "weather.forecast_home",
                "attribute": "uv_index",
                "above": 2
              },
              {
                "trigger": "state",
                "entity_id": "weather.forecast_home",
                "to": "sunny"
              }
            ],
            "conditions": [
              {
                "condition": "state",
                "entity_id": "switch.foyer_light_switch_1",
                "state": "on"
              },
              {
                "condition": "template",
                "value_template": "{{ state_attr('sun.sun', 'elevation') | float(-1) > 0 }}"
              }
            ],
            "actions": [
              {
                "action": "switch.turn_off",
                "target": {
                  "entity_id": "switch.foyer_light_switch_1"
                }
              }
            ]
          },
          "blueprint_inputs": null,
          "context": {
            "id": "01KYEZKJPD96TX7Z8P65SBYQDN",
            "parent_id": "01KYEXWMWC77F52TMYDM9MSEK8",
            "user_id": null
          }
        },
