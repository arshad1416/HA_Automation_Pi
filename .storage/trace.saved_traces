            ],
            "action/14/then/0": [
              {
                "path": "action/14/then/0",
                "timestamp": "2026-07-10T15:30:17.214839+00:00",
                "result": {
                  "params": {
                    "domain": "notify",
                    "service": "mobile_app_cph2655",
                    "service_data": {
                      "message": "Climate AI: Set 22.5C cool Fans: kitchen=off, master=2, mina=2, guest=off, izaan=3 - Mid-peak utility rate period. Upstairs temperatures are slightly elevated, particularly in Izaan's room (23.2C). Keeping HVAC in cooling mode at 22.5C, with increased fan speed and vent boosting in Izaan's room to balance the climate. High cloud cover (78.1%) warrants keeping all blinds open.",
                      "title": "Climate AI"
