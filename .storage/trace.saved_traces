          },
          "domain": "automation",
          "item_id": "climate_ai_advisor",
          "trigger": "time pattern",
          "trace": {
            "trigger/0": [
              {
                "path": "trigger/0",
                "timestamp": "2026-07-26T07:00:00.246640+00:00",
                "changed_variables": {
                  "this": {
                    "entity_id": "automation.climate_ai_advisor",
