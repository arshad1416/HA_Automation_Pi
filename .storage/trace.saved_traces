          "config": {
            "id": "valve_1_phantom_open_guard",
            "alias": "Front Lawn Valve 1 - Phantom-Open Guard",
            "description": "valve_1 (Front Lawn Sprinkler zone 1) is in no watering schedule, so it should never open on its own. If it stays on for 1 s and a person did not open it (Zigbee reconnection glitch, or the device's onboard Tuya timer), close it and notify. 1 s is deliberately aggressive (user opted for max sensitivity 2026-07-11): it catches even the brief self-correcting reconnect blips (2-5 s observed), so a Zigbee wobble may send a few notifications; it only filters sub-second comms flicker. Manual opens (which carry a user context) are left alone. If valve_1 is ever added to a real watering automation, disable this guard.",
            "mode": "single",
            "triggers": [
              {
                "trigger": "state",
                "entity_id": "switch.tze284_8zizsafo_ts0601_valve_1",
                "to": "on",
                "for": {
                  "seconds": 1
                }
              }
            ],
            "conditions": [
              {
                "condition": "template",
                "value_template": "{{ trigger.to_state.context.user_id is none }}"
              }
            ],
            "actions": [
              {
                "action": "switch.turn_off",
                "target": {
                  "entity_id": "switch.tze284_8zizsafo_ts0601_valve_1"
                },
                "continue_on_error": true
              },
              {
                "action": "notify.mobile_app_cph2655",
                "data": {
                  "title": "\ud83d\udca7 Front Lawn Valve 1 auto-closed",
                  "message": "Front Lawn Sprinkler valve 1 opened on its own (nothing schedules it) and was auto-closed \u2014 most likely a Zigbee reconnect or the device onboard timer. If this keeps happening, the valve needs better Zigbee coverage."
                }
              }
            ]
          },
