            "condition/0": [
              {
                "path": "condition/0",
                "timestamp": "2026-07-26T22:35:22.988647+00:00",
                "result": {
                  "result": false,
                  "entities": [
                    "climate.ecobee"
                  ]
                }
              }
            ]
          },
          "config": {
            "id": "hvac_pause_door_open",
            "alias": "HVAC Pause: Door open too long",
            "description": "Pause HVAC when front door or garage entry door stays open >2 min while the ecobee is actively heating/cooling. Captures the active mode into input_text.climate_ai_last_mode before pausing and restores it when the door closes (Enhancement C).",
            "mode": "single",
            "triggers": [
              {
                "entity_id": "binary_sensor.front_door_door",
                "to": "on",
                "for": "00:02:00",
                "trigger": "state"
              },
              {
                "entity_id": "binary_sensor.garages_entry_door_door",
                "to": "on",
                "for": "00:02:00",
                "trigger": "state"
              }
            ],
            "conditions": [
              {
                "condition": "template",
                "value_template": "{{ state_attr('climate.ecobee', 'hvac_action') in ['heating', 'cooling'] }}"
              },
              {
                "condition": "state",
                "entity_id": "input_boolean.hvac_paused_door_open",
                "state": "off"
              }
            ],
            "actions": [
              {
                "action": "input_boolean.turn_on",
                "target": {
                  "entity_id": "input_boolean.hvac_paused_door_open"
                }
              },
              {
                "action": "input_text.set_value",
                "target": {
                  "entity_id": "input_text.climate_ai_last_mode"
                },
                "data": {
                  "value": "{{ states('climate.ecobee') }}"
                }
              },
              {
                "action": "climate.set_hvac_mode",
                "data": {
                  "hvac_mode": "off"
                },
                "target": {
                  "entity_id": "climate.ecobee"
                }
              },
              {
                "action": "notify.mobile_app_cph2655",
                "data": {
                  "title": "HVAC Paused",
                  "message": "{{ trigger.to_state.attributes.friendly_name }} open >2 min while HVAC active. Paused to save energy. Will resume when closed."
                }
              },
              {
                "wait_template": "{{ is_state('binary_sensor.front_door_door', 'off') and is_state('binary_sensor.garages_entry_door_door', 'off') }}",
                "timeout": "01:00:00"
              },
              {
                "action": "climate.set_hvac_mode",
                "data": {
                  "hvac_mode": "{% set m = states('input_text.climate_ai_last_mode') | default('', true) | trim | lower %} {{ m if m in ['off', 'heat', 'cool', 'heat_cool'] else 'heat_cool' }}\n"
                },
                "target": {
                  "entity_id": "climate.ecobee"
                }
              },
              {
                "action": "input_boolean.turn_off",
                "target": {
                  "entity_id": "input_boolean.hvac_paused_door_open"
                }
              }
            ]
          },
          "blueprint_inputs": null,
          "context": {
            "id": "01KYG934ZCV28GRYH06JTD7484",
            "parent_id": "01KYG8ZFS8KV5R3NPAXTMHVMJX",
            "user_id": null
          }
        },
