          },
          "config": {
            "id": "climate_season_switch",
            "alias": "climate_season_switch",
            "description": "Daily 3am check 7-day mean outdoor temp. 3-day hysteresis with counter tracking.",
            "mode": "single",
            "triggers": [
              {
                "trigger": "time",
                "at": "03:00:00"
              }
            ],
            "conditions": [],
            "actions": [
              {
                "if": [
                  {
                    "condition": "numeric_state",
                    "entity_id": "sensor.outdoor_temp_7_day_mean_2",
                    "above": 15
                  }
                ],
                "then": [
                  {
                    "action": "counter.increment",
                    "target": {
                      "entity_id": "counter.season_switch_summer"
                    }
                  },
                  {
                    "action": "counter.reset",
                    "target": {
                      "entity_id": "counter.season_switch_winter"
                    }
                  }
                ],
                "else": [
                  {
                    "if": [
                      {
                        "condition": "numeric_state",
                        "entity_id": "sensor.outdoor_temp_7_day_mean_2",
                        "below": 10
                      }
                    ],
                    "then": [
                      {
                        "action": "counter.increment",
                        "target": {
                          "entity_id": "counter.season_switch_winter"
                        }
                      },
                      {
                        "action": "counter.reset",
                        "target": {
                          "entity_id": "counter.season_switch_summer"
                        }
                      }
                    ],
                    "else": [
                      {
                        "action": "counter.reset",
                        "target": {
                          "entity_id": "counter.season_switch_summer"
                        }
                      },
                      {
                        "action": "counter.reset",
                        "target": {
                          "entity_id": "counter.season_switch_winter"
                        }
                      }
                    ]
                  }
                ]
              },
              {
                "if": [
                  {
                    "condition": "numeric_state",
                    "entity_id": "counter.season_switch_summer",
                    "above": 2
                  }
                ],
                "then": [
                  {
                    "action": "input_boolean.turn_on",
                    "target": {
                      "entity_id": "input_boolean.climate_summer_mode"
                    }
                  },
                  {
                    "action": "input_boolean.turn_off",
                    "target": {
                      "entity_id": "input_boolean.climate_winter_mode"
                    }
                  },
                  {
                    "action": "counter.reset",
                    "target": {
                      "entity_id": "counter.season_switch_summer"
                    }
                  },
                  {
                    "action": "counter.reset",
                    "target": {
                      "entity_id": "counter.season_switch_winter"
                    }
                  }
                ]
              },
              {
                "if": [
                  {
                    "condition": "numeric_state",
                    "entity_id": "counter.season_switch_winter",
                    "above": 2
                  }
                ],
                "then": [
                  {
                    "action": "input_boolean.turn_on",
                    "target": {
                      "entity_id": "input_boolean.climate_winter_mode"
                    }
                  },
                  {
                    "action": "input_boolean.turn_off",
                    "target": {
                      "entity_id": "input_boolean.climate_summer_mode"
                    }
                  },
                  {
                    "action": "counter.reset",
                    "target": {
                      "entity_id": "counter.season_switch_summer"
                    }
                  },
                  {
                    "action": "counter.reset",
                    "target": {
                      "entity_id": "counter.season_switch_winter"
                    }
                  }
                ]
              }
            ]
          },
          "blueprint_inputs": null,
          "context": {
            "id": "01KYEKJDM8SD6FZC8RB599ZWYX",
            "parent_id": null,
            "user_id": null
          }
        },
        "short_dict": {
          "last_step": "action/2/if/condition/0/entity_id/0",
