          "config": {
            "alias": "Lawn watering: morning report",
            "description": "Daily 07:00 report on the Smart Irrigation calculation and whether the front-lawn valve ran since 23:00. Catches a silent calc/mapping failure.",
            "id": "lawn_watering_morning_report",
            "mode": "single",
            "triggers": [
              {
                "trigger": "time",
                "at": "07:00:00"
              }
            ],
            "actions": [
              {
                "variables": {
                  "dur_min": "{{ states('sensor.smart_irrigation_front_lawn_valve_2') | float(0) | round(0) | int }}",
                  "valve_last": "{{ state_attr('switch.dual_outlet_irrigation_timer_switch_2', 'last_changed') }}",
                  "master": "{{ is_state('input_boolean.lawn_watering_master_enable', 'on') }}",
                  "odd_day": "{{ now().day % 2 == 1 }}",
                  "last_watered": "{{ state_attr('input_datetime.lawn_last_watered', 'timestamp') }}",
                  "ran_since_2300": "{% set cutoff = as_timestamp(now().replace(hour=0, minute=0, second=0, microsecond=0)) - 3600 %} {% set v_ts = as_timestamp(valve_last) if valve_last else 0 %} {% set lw_ts = last_watered if last_watered else 0 %} {{ v_ts > cutoff or lw_ts > cutoff }}"
                }
              },
              {
                "action": "notify.mobile_app_cph2655",
                "data": {
                  "title": "\ud83c\udf31 Lawn watering status",
                  "message": "Calc need: {{ dur_min }} min. {% if dur_min > 0 %}Valve ran since 23:00: {{ 'YES' if ran_since_2300 else 'NO \u2014 check!' }}. {% else %}No water needed (or calc/mapping issue \u2014 verify). {% endif %} Master: {{ 'ON' if master else 'OFF' }} | Odd-day allowed: {{ 'yes' if odd_day else 'no' }}."
                }
              }
            ]
          },
