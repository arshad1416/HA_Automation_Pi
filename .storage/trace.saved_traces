                  "low_batteries": "{% set sensors = [\n  'sensor.front_door_battery',\n  'sensor.front_door_battery_2',\n  'sensor.garages_entry_door_battery',\n  'sensor.airbnb_battery',\n  'sensor.airbnb_door_battery',\n  'sensor.basement_battery',\n  'sensor.basement_bathroom_leak_sensor_battery',\n  'sensor.ensuite_leak_sensor_battery',\n  'sensor.guest_bathroom_leak_sensor_battery',\n  'sensor.kitchen_leak_sensor_battery',\n  'sensor.laundry_room_leak_sensor_battery',\n  'sensor.powder_room_leak_sensor_battery',\n  'sensor.sump_pump_leak_sensor_battery',\n  'sensor.izaans_room_battery',\n  'sensor.minas_room_battery',\n  'sensor.cat_feeder_battery'\n] %} {% set ns = namespace(low=[]) %} {% for s in sensors %}\n  {% set val = states(s) | int(-1) %}\n  {% if val >= 0 and val < 20 %}\n    {% set ns.low = ns.low + [s ~ ' (' ~ val ~ '%)'] %}\n  {% endif %}\n{% endfor %} {{ ns.low | join(', ') }}"
                }
              },
              {
                "condition": "template",
                "value_template": "{{ low_batteries | length > 0 }}"
              },
              {
                "action": "notify.mobile_app_cph2655",
                "data": {
                  "message": "Low battery alert: {{ low_batteries }}",
                  "title": "\ud83d\udd0b Low Battery Alert"
                }
              }
            ]
          },
