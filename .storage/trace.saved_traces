            "id": "bedtime_routine_auto",
            "alias": "Bed Time Light Routine",
            "description": "Locks doors, shuts garage, turns off inside lights when asleep. Only fires after 21:00 to prevent daytime nap false triggers. 22:00 catch-up trigger handles early bedtimes. TV playing bypasses the sleep-confidence triggers but catch-up at 22:00 always fires regardless of TV state.\n",
            "triggers": [
              {
                "entity_id": "sensor.oneplus_13_sleep_confidence",
                "above": 80,
                "for": {
