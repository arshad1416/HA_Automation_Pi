    "automation.climate_ai_advisor": [
      {
        "extended_dict": {
          "last_step": "condition/1",
          "run_id": "56575ad9fd599c67dd6a1ad645021766",
          "state": "stopped",
          "script_execution": "failed_conditions",
          "timestamp": {
