                }
              }
            ],
            "condition/0": [
              {
                "path": "condition/0",
                "timestamp": "2026-07-17T03:30:00.204176+00:00",
                "result": {
                  "result": false,
                  "entities": []
                }
              }
            ]
          },
          "config": {
            "actions": [
              {
                "action": "lock.lock",
                "target": {
                  "entity_id": "{{ states.lock\n   | rejectattr('entity_id', 'eq', 'lock.airbnb')\n   | selectattr('state', 'eq', 'unlocked')\n   | map(attribute='entity_id')\n   | list }}\n"
                }
              },
              {
                "data": {
                  "agent_id": "conversation.google_ai_conversation",
                  "text": "These locks were unlocked and have been automatically locked: {{ unlocked }}. Compose a one-sentence, calm bedtime message confirming the locks are now secure.\n"
                },
                "response_variable": "agent",
                "action": "conversation.process"
              },
              {
                "data": {
                  "data": {
                    "type": "announce"
                  },
                  "message": "{{ agent.response.speech.plain.speech }}",
                  "target": [
                    "media_player.upstairs_echo_dot"
                  ]
                },
                "action": "notify.alexa_media"
              }
            ],
            "alias": "Proactive: nightly lock check + auto-lock",
            "conditions": [
              {
                "condition": "template",
                "value_template": "{{ unlocked != '' }}"
              }
            ],
            "description": "At 23:30, lock any unlocked locks (excluding Airbnb) and announce via LLM-generated narration through the upstairs Echo.",
            "id": "proactive_nightly_lock_check",
            "mode": "single",
            "triggers": [
              {
                "at": "23:30:00",
                "trigger": "time"
              }
            ],
            "variables": {
              "unlocked": "{{ states.lock\n   | rejectattr('entity_id', 'eq', 'lock.airbnb')\n   | selectattr('state', 'eq', 'unlocked')\n   | map(attribute='attributes.friendly_name')\n   | list\n   | join(', ') }}\n"
            }
          },
          "blueprint_inputs": null,
          "context": {
            "id": "01KXQ1ZDWBVZD0W47NY4X5TY09",
            "parent_id": null,
            "user_id": null
          }
