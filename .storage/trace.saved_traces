            "description": "Echo presence with ecobee NOT detecting -> dim day/late-night brightness (defers to the 100% rule when the ecobee is detecting). Turns the stair light OFF when the ECOBEE stops detecting motion -- the Echo presence is unreliable, so it does not gate the off.",
            "mode": "restart",
            "triggers": [
              {
                "entity_id": "switch.stairs_occupancy",
                "id": "stairs_on",
                "to": "on",
                "trigger": "state"
              },
              {
                "entity_id": "binary_sensor.ecobee_motion",
                "id": "ecobee_off",
                "to": "off",
                "trigger": "state"
              }
            ],
            "conditions": [],
            "actions": [
              {
                "choose": [
                  {
                    "conditions": [
                      {
                        "condition": "trigger",
                        "id": "stairs_on"
                      },
                      {
                        "condition": "state",
                        "entity_id": "binary_sensor.ecobee_motion",
                        "state": "off"
                      }
                    ],
                    "sequence": [
                      {
                        "choose": [
                          {
                            "conditions": [
                              {
                                "condition": "time",
                                "after": "22:00:00",
                                "before": "07:00:00"
                              }
                            ],
                            "sequence": [
                              {
                                "action": "light.turn_on",
                                "data": {
                                  "brightness_pct": "{{ states('input_number.stairs_late_night_brightness') | int }}"
                                },
                                "target": {
                                  "entity_id": "light.stair_light"
                                }
                              }
                            ]
                          },
                          {
                            "conditions": [
                              {
                                "condition": "time",
                                "after": "07:00:00",
                                "before": "22:00:00"
                              }
                            ],
                            "sequence": [
                              {
                                "action": "light.turn_on",
                                "data": {
                                  "brightness_pct": "{{ states('input_number.stairs_day_brightness') | int }}"
                                },
                                "target": {
                                  "entity_id": "light.stair_light"
                                }
                              }
                            ]
                          }
                        ],
                        "default": [
                          {
                            "action": "light.turn_on",
                            "data": {
                              "brightness_pct": 100
                            },
                            "target": {
                              "entity_id": "light.stair_light"
                            }
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "conditions": [
                      {
                        "condition": "trigger",
                        "id": "ecobee_off"
                      }
                    ],
                    "sequence": [
                      {
                        "action": "light.turn_off",
                        "target": {
                          "entity_id": "light.stair_light"
                        }
                      }
                    ]
                  }
                ]
              }
            ]
          },
          "blueprint_inputs": null,
          "context": {
            "id": "01KYGHA37MKP3F7HVCEASS20VC",
            "parent_id": "01KYGHA37MMDGQ4JD38BEZ6JJQ",
            "user_id": null
          }
        },
        "short_dict": {
