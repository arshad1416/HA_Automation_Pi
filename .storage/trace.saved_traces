                }
              }
            ],
            "action/13/then/0": [
              {
                "path": "action/13/then/0",
                "timestamp": "2026-07-10T15:45:21.544839+00:00",
                "result": {
                  "params": {
                    "domain": "notify",
                    "service": "persistent_notification",
                    "service_data": {
                      "message": "Set: 22.5C Mode: cool Fans: kitchen=off, master=2, mina=2, guest=off, izaan=2 Vents: Iz=80% Mi=40% Blinds: {\"dining\":100,\"family\":100,\"living\":100,\"mina\":100} - It is a humid, rainy summer midday during Mid-Peak hours. Maintaining the cooling setpoint at 22.5C. Because cloud cover is over 40% (56.2%), all blinds are kept 100% open. Ceiling fans in the master, mina, and izaan rooms are set to medium to distribute cool air upstairs, with vent boosters active to assist in balancing the warmer upper-level temperatures.",
                      "title": "Climate AI: 22.5C cool"
                    },
                    "target": {}
                  },
                  "running_script": false
                }
              }
            ],
            "action/14": [
              {
                "path": "action/14",
