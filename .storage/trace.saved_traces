                "data": {
                  "agent_id": "conversation.google_ai_conversation",
                  "text": "Arshad just got home. Compose a one-sentence greeting using the current weather ({{ states('weather.forecast_home') }}, {{ state_attr('weather.forecast_home', 'temperature') }}\u00b0C) and the next calendar event ({{ state_attr('calendar.arshad14_gmail_com', 'message') }}).\n"
