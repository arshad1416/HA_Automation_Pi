          "config": {
            "id": "stairs_echo_ecobee_motion",
            "alias": "Stairs Light - Echo + Ecobee Motion (100%)",
            "description": "When the upstairs Echo presence (switch.stairs_occupancy) AND the ecobee motion sensor both detect motion, and it is dark out (overcast day or after sunset), turn the stair light to 100%.",
            "mode": "single",
            "triggers": [
              {
                "trigger": "state",
                "entity_id": "switch.stairs_occupancy",
                "to": "on"
              },
              {
                "trigger": "state",
                "entity_id": "binary_sensor.ecobee_motion",
                "to": "on"
              }
            ],
            "conditions": [
              {
                "condition": "state",
                "entity_id": "switch.stairs_occupancy",
                "state": "on"
              },
              {
                "condition": "state",
                "entity_id": "binary_sensor.ecobee_motion",
                "state": "on"
              },
              {
                "condition": "or",
                "conditions": [
                  {
                    "condition": "state",
                    "entity_id": "sun.sun",
                    "state": "below_horizon"
                  },
                  {
                    "condition": "template",
                    "value_template": "{{ state_attr('sun.sun', 'elevation') | float(90) < 10 }}"
                  },
                  {
                    "condition": "state",
                    "entity_id": "weather.forecast_home",
                    "state": [
                      "cloudy",
                      "rainy",
                      "snowy",
                      "fog",
                      "overcast",
                      "partlycloudy"
                    ]
                  }
                ]
              }
            ],
            "actions": [
              {
                "action": "light.turn_on",
                "target": {
                  "entity_id": "light.stair_light"
                },
                "data": {
                  "brightness_pct": 100
                }
              }
            ]
          },
          "blueprint_inputs": null,
          "context": {
            "id": "01KX8YB9538S22V17NRP83M8PT",
            "parent_id": "01KX8YB9522H582MSKV7WS5WTG",
            "user_id": null
          }
