          "config": {
            "id": "ev_arrival_low_charge_alert",
            "alias": "EV: Low charge arrival alert",
            "description": "When Arshad arrives home with SoC < 30% and the charger idle, announce a plug-in reminder on the downstairs Echo.",
            "mode": "single",
            "triggers": [
              {
                "entity_id": "person.arshad14",
                "to": "home",
                "trigger": "state"
              }
            ],
            "conditions": [
              {
                "condition": "template",
                "value_template": "{{ states('sensor.ioniq_6_ev_battery_level') | default(100, true) | float(100) < 30 }}"
              },
              {
                "condition": "template",
                "value_template": "{{ states('sensor.grizzl_e_power') | default(0, true) | float(0) < 50 }}"
              }
            ],
            "actions": [
              {
                "delay": "00:05:00"
              },
              {
                "condition": "template",
                "value_template": "{{ states('sensor.grizzl_e_power') | default(0, true) | float(0) < 50 }}"
              },
              {
                "action": "notify.alexa_media",
                "data": {
                  "data": {
                    "type": "announce"
                  },
                  "message": "Welcome home. Your car is at {{ states('sensor.ioniq_6_ev_battery_level') | default('unknown', true) }} percent. Consider plugging in to catch off-peak rates.",
                  "target": [
                    "media_player.downstairs_echo_dot"
                  ]
                }
              }
            ]
          },
