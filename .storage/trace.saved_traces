          "config": {
            "id": "auto_restore_ac_after_cold_day",
            "alias": "Auto-restore AC after cold day",
            "description": "Restore AC/cool mode on ecobee after a cold day passes and temperature rises.",
            "mode": "single",
            "triggers": [
              {
                "above": 22,
                "entity_id": "sensor.ecobee_current_temperature",
                "trigger": "numeric_state"
              }
            ],
            "conditions": [
              {
                "condition": "state",
                "entity_id": "climate.ecobee",
                "attribute": "hvac_mode",
                "state": "heat"
              },
              {
                "condition": "numeric_state",
                "entity_id": "weather.forecast_home",
                "attribute": "temperature",
                "above": 20
              }
            ],
            "actions": [
              {
                "action": "climate.set_hvac_mode",
                "data": {
                  "hvac_mode": "cool"
                },
                "target": {
                  "entity_id": "climate.ecobee"
                }
              },
              {
                "action": "notify.mobile_app_cph2655",
                "data": {
                  "message": "AC restored to cool mode after cold day passed."
                }
              }
            ]
          },
