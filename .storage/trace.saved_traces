            ]
          },
          "config": {
            "id": "office_heater_smart_control",
            "alias": "Office Heater Smart Control",
            "description": "Heats the office (climate.office_heater_2) to 21\u00b0C while the office mmWave sees someone AND the room is below 20\u00b0C (the cold trigger also re-heats during continuous occupancy); off after 30 min empty or once the room passes 23\u00b0C. Blocked while house_away is on \u2014 the mmWave is cat-trippable and away-mode owns the heater then. Fixed 2026-07-10: previous version read the Pi CPU temperature as the room temp and toggled the child-lock switch instead of the heater.",
            "mode": "single",
            "triggers": [
              {
                "entity_id": "binary_sensor.usb_c_mmwave_sensor_presence",
                "to": "on",
                "id": "occupied",
                "trigger": "state"
              },
              {
                "entity_id": "binary_sensor.usb_c_mmwave_sensor_presence",
                "to": "off",
                "for": {
                  "minutes": 30
                },
                "id": "unoccupied",
                "trigger": "state"
              },
              {
                "trigger": "numeric_state",
                "entity_id": "climate.office_heater_2",
                "attribute": "current_temperature",
                "above": 23,
                "id": "warm_enough"
              },
              {
                "trigger": "numeric_state",
                "entity_id": "climate.office_heater_2",
                "attribute": "current_temperature",
                "below": 20,
                "id": "cold"
              }
            ],
            "conditions": [],
            "actions": [
              {
                "choose": [
                  {
                    "conditions": [
                      {
                        "condition": "trigger",
                        "id": [
                          "occupied",
                          "cold"
                        ]
                      },
                      {
                        "condition": "state",
                        "entity_id": "binary_sensor.usb_c_mmwave_sensor_presence",
                        "state": "on"
                      },
                      {
                        "condition": "numeric_state",
                        "entity_id": "climate.office_heater_2",
                        "attribute": "current_temperature",
                        "below": 20
                      },
                      {
                        "condition": "state",
                        "entity_id": "input_boolean.house_away",
                        "state": "off"
                      }
                    ],
                    "sequence": [
                      {
                        "action": "climate.set_hvac_mode",
                        "target": {
                          "entity_id": "climate.office_heater_2"
                        },
                        "data": {
                          "hvac_mode": "heat"
                        }
                      },
                      {
                        "action": "climate.set_temperature",
                        "target": {
                          "entity_id": "climate.office_heater_2"
                        },
                        "data": {
                          "temperature": 21
                        }
                      }
                    ]
                  },
                  {
                    "conditions": [
                      {
                        "condition": "trigger",
                        "id": [
                          "unoccupied",
                          "warm_enough"
                        ]
                      }
                    ],
                    "sequence": [
                      {
                        "action": "climate.set_hvac_mode",
                        "target": {
                          "entity_id": "climate.office_heater_2"
                        },
                        "data": {
                          "hvac_mode": "off"
                        }
                      }
                    ]
                  }
                ]
              }
            ]
          },
