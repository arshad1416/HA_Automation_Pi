                "state": "off"
              }
            ],
            "actions": [
              {
                "variables": {
                  "unlocked_locks": "{{ states.lock\n   | rejectattr('entity_id', 'eq', 'lock.airbnb')\n   | selectattr('state', 'eq', 'unlocked')\n   | map(attribute='attributes.friendly_name')\n   | list | join(', ') }}\n",
                  "heater_on": "{{ is_state('switch.office_heater_child_lock', 'on') }}"
                }
              },
              {
                "if": [
                  {
                    "condition": "template",
                    "value_template": "{{ unlocked_locks != '' }}"
                  }
                ],
                "then": [
                  {
                    "action": "lock.lock",
                    "target": {
                      "entity_id": "{{ states.lock\n   | rejectattr('entity_id', 'eq', 'lock.airbnb')\n   | selectattr('state', 'eq', 'unlocked')\n   | map(attribute='entity_id')\n   | list }}\n"
                    }
                  }
                ]
              },
              {
                "if": [
                  {
                    "condition": "template",
                    "value_template": "{{ heater_on }}"
                  }
                ],
                "then": [
                  {
                    "action": "switch.turn_off",
                    "target": {
                      "entity_id": "switch.office_heater_child_lock"
                    }
                  }
                ]
              },
              {
                "action": "notify.mobile_app_cph2655",
                "data": {
                  "title": "\ud83c\udfe0 Departure Check",
                  "message": "Everyone left. {{ 'Locked: ' ~ unlocked_locks ~ '. ' if unlocked_locks else '' }}{{ 'Office heater turned off. ' if heater_on else '' }}{{ 'All secure.' if not unlocked_locks and not heater_on else '' }}\n"
                }
              }
            ]
          },
          "blueprint_inputs": null,
          "context": {
            "id": "01KYG41NEHRS6689XYGM6XDF0Q",
            "parent_id": "01KYG41NEETGQTFR3Q9B8YH1RD",
            "user_id": null
          }
        },
