    "automation.bedtime_routine_auto": [
      {
        "extended_dict": {
          "last_step": "condition/0/entity_id/0",
          "run_id": "92d3feb52b4b9b706b0521662e611571",
          "state": "stopped",
          "script_execution": "failed_conditions",
          "timestamp": {
            "start": "2026-07-11T19:30:00.078327+00:00",
            "finish": "2026-07-11T19:30:00.078454+00:00"
          },
          "domain": "automation",
          "item_id": "bedtime_routine_auto",
          "trigger": "time pattern",
          "trace": {
            "trigger/2": [
              {
                "path": "trigger/2",
                "timestamp": "2026-07-11T19:30:00.078377+00:00",
                "changed_variables": {
                  "this": {
                    "entity_id": "automation.bed_time_light_routine",
                    "state": "on",
                    "attributes": {
                      "id": "bedtime_routine_auto",
                      "last_triggered": "2026-07-11T03:30:00.455889+00:00",
                      "mode": "single",
                      "current": 0,
                      "friendly_name": "Bed Time Light Routine"
                    },
                    "last_changed": "2026-07-11T14:47:59.196333+00:00",
                    "last_reported": "2026-07-11T14:47:59.196333+00:00",
                    "last_updated": "2026-07-11T14:47:59.196333+00:00",
                    "context": {
                      "id": "01KX8TCHEWSDM4E9A1XHSJP6HA",
                      "parent_id": null,
                      "user_id": null
                    }
                  },
                  "trigger": {
                    "id": "sleep_check",
                    "idx": "2",
                    "alias": null,
                    "platform": "time_pattern",
                    "now": "2026-07-11T15:30:00.078195-04:00",
                    "description": "time pattern"
                  }
                }
              }
            ],
            "condition/0": [
              {
                "path": "condition/0",
                "timestamp": "2026-07-11T19:30:00.078406+00:00",
                "result": {
                  "result": false
                }
              }
            ],
            "condition/0/entity_id/0": [
              {
                "path": "condition/0/entity_id/0",
                "timestamp": "2026-07-11T19:30:00.078420+00:00",
                "result": {
                  "result": false,
                  "state": "on",
                  "wanted_state": "off"
                }
              }
            ]
          },
          "config": {
            "id": "bedtime_routine_auto",
            "alias": "Bed Time Light Routine",
            "description": "Locks doors, shuts garage, turns off inside lights once we are actually asleep. Instead of a blunt 10 PM shutoff it VERIFIES sleep every 30 min from 9 PM. Runs at most once per night (input_boolean.bedtime_shutdown_done latch, reset at 20:00). Fires when, and only when, one of:\n  (1) IMMEDIATE \u2014 Arshad's phone reports sleep (sensor.cph2655_sleep_confidence >80 for 10 min) or Sleep-as-Android turns on, any time 21:00-11:00 (daytime naps excluded).\n  (2) HALF-HOURLY POLL \u2014 at every :00/:30 from 21:00-04:00, if phone sleep-confidence is currently >80 (verified asleep).\n  (3) FALLBACK for nights the phone isn't sleep-tracking \u2014 same poll, 23:00-04:00, if the house has clearly settled: family-room TV (lg_webos_tv_cd70) not on/playing AND no kitchen/family/island light toggled in the last 30 min.\nFixed 2026-07-10: sleep sensor was the non-existent sensor.oneplus_13_sleep_confidence (phone is CPH2655); TV guard watched an unavailable TV (un8500auj).\n",
            "triggers": [
              {
                "entity_id": "sensor.cph2655_sleep_confidence",
                "above": 80,
                "for": {
                  "minutes": 10
                },
                "trigger": "numeric_state",
                "id": "sleep_detected"
              },
              {
                "entity_id": "calendar.sleep_as_android",
                "to": "on",
                "trigger": "state",
                "id": "sleep_detected"
              },
              {
                "trigger": "time_pattern",
                "minutes": "/30",
                "id": "sleep_check"
              }
            ],
            "conditions": [
              {
                "condition": "state",
                "entity_id": "input_boolean.bedtime_shutdown_done",
                "state": "off"
              },
              {
                "condition": "or",
                "conditions": [
                  {
                    "condition": "and",
                    "conditions": [
                      {
                        "condition": "trigger",
                        "id": "sleep_detected"
                      },
                      {
                        "condition": "time",
                        "after": "21:00:00",
                        "before": "11:00:00"
                      }
                    ]
                  },
                  {
                    "condition": "and",
                    "conditions": [
                      {
                        "condition": "trigger",
                        "id": "sleep_check"
                      },
                      {
                        "condition": "time",
                        "after": "21:00:00",
                        "before": "04:00:00"
                      },
                      {
                        "condition": "numeric_state",
                        "entity_id": "sensor.cph2655_sleep_confidence",
                        "above": 80
                      }
                    ]
                  },
                  {
                    "condition": "and",
                    "conditions": [
                      {
                        "condition": "trigger",
                        "id": "sleep_check"
                      },
                      {
                        "condition": "time",
                        "after": "23:00:00",
                        "before": "04:00:00"
                      },
                      {
                        "condition": "template",
                        "value_template": "{{ states('media_player.lg_webos_tv_cd70') not in ['on', 'playing'] }}"
                      },
                      {
                        "condition": "template",
