                }
              }
            ],
            "action/5": [
              {
                "path": "action/5",
                "timestamp": "2026-07-11T15:40:06.816739+00:00",
                "result": {
                  "params": {
                    "domain": "notify",
                    "service": "mobile_app_cph2655",
                    "service_data": {
                      "title": "\u2705 Front lawn watered",
                      "message": "Ran 360 s (6.0 min), Smart Irrigation calc. Bucket reset."
                    },
                    "target": {}
                  },
                  "running_script": false
                }
              }
            ]
          },
          "config": {
            "alias": "Lawn watering: start cycle",
            "description": "Waters the front lawn at 05:00 for the Smart Irrigation computed duration, then turns off and calls smart_irrigation.reset_bucket so the deficit resets. Smart Irrigation still CALCULATES the amount at its own 23:00 calc time; this automation just runs the valve at 5 AM if that calc left a positive duration. Rewritten 2026-07-11: SI sensor is SECONDS (delay uses it directly); the old wait_for_trigger/delay ordering was dead code; trigger changed from the sensor-crossing to a fixed 05:00 time (per user). run_seconds capped at 3600 s (the zone maximum_duration); the separate valve_2 Max Runtime Failsafe (60 min) is the independent hard backstop. Held DISABLED (initial_state:false) until a supervised live test; re-enable by removing that line.\n",
            "id": "lawn_watering_start",
            "initial_state": false,
            "mode": "single",
            "triggers": [
              {
                "trigger": "time",
                "at": "05:00:00"
              }
            ],
            "conditions": [
              {
                "condition": "numeric_state",
                "entity_id": "sensor.smart_irrigation_front_lawn_valve_2",
                "above": 0
              },
              {
                "condition": "template",
                "value_template": "{{ now().day % 2 == 1 and\n   is_state('input_boolean.lawn_watering_master_enable', 'on') }}"
              }
            ],
            "actions": [
              {
                "variables": {
                  "run_seconds": "{{ [ states('sensor.smart_irrigation_front_lawn_valve_2') | float(0) | round(0) | int, 3600 ] | min }}"
                }
              },
              {
                "action": "switch.turn_on",
                "target": {
                  "entity_id": "switch.tze284_8zizsafo_ts0601_valve_2"
                }
              },
              {
                "delay": {
                  "seconds": "{{ run_seconds }}"
                }
              },
              {
                "action": "switch.turn_off",
                "target": {
                  "entity_id": "switch.tze284_8zizsafo_ts0601_valve_2"
                }
              },
              {
                "action": "smart_irrigation.reset_bucket",
                "target": {
                  "entity_id": "sensor.smart_irrigation_front_lawn_valve_2"
                }
              },
              {
                "action": "notify.mobile_app_cph2655",
                "data": {
                  "title": "\u2705 Front lawn watered",
                  "message": "Ran {{ run_seconds }} s ({{ (run_seconds / 60) | round(1) }} min), Smart Irrigation calc. Bucket reset."
                }
              }
            ]
          },
          "blueprint_inputs": null,
          "context": {
            "id": "01KX8X106R8NEY4J3C2AERMK8V",
            "parent_id": "01KX8X106Q0N9NZ7RW3Q6E1H7S",
            "user_id": null
          }
        },
