            "id": "auto_restore_ac_after_cold_day",
            "alias": "Auto-restore AC after cold day",
            "description": "Restore AC/cool mode on ecobee after a cold day passes and temperature rises.",
            "mode": "single",
            "triggers": [
              {
                "above": 22,
                "entity_id": "sensor.ecobee_current_temperature",
                "trigger": "numeric_state"
              }
            ],
            "conditions": [
