              }
            ]
          },
          "config": {
            "alias": "Lawn watering: start cycle",
            "description": "Waters the front lawn at 05:00 for the Smart Irrigation computed duration, then turns off and calls smart_irrigation.reset_bucket so the deficit resets. SI calculates at 04:00; this runs the valve at 05:00 when there is a positive duration AND the last watering was >=2 days ago (deep-and-infrequent watering, user 2026-07-13 \u2014 deficit accumulates across skipped days). Calibrated 2026-07-13: zone throughput 13.4 L/min (METER-MEASURED: 67 L in 5 min; was 25) and zone maximum_duration raised to 5400 s, so expect ~40-80 min runs every other day (~25 mm/week incl. rain credit). run_seconds capped at 5400 s; the valve_2 Max Runtime Failsafe (100 min) is the independent hard backstop.\n",
            "id": "lawn_watering_start",
            "mode": "single",
            "triggers": [
              {
                "trigger": "time",
                "at": "05:00:00"
              }
            ],
            "conditions": [
              {
                "condition": "numeric_state",
                "entity_id": "sensor.smart_irrigation_front_lawn_valve_2",
                "above": 0
              },
              {
                "condition": "state",
                "entity_id": "input_boolean.lawn_watering_master_enable",
                "state": "on"
              },
              {
                "condition": "template",
                "value_template": "{{ state_attr('automation.lawn_watering_start_cycle', 'last_triggered') is none\n   or (now() - state_attr('automation.lawn_watering_start_cycle', 'last_triggered')).total_seconds() >= 169200 }}"
              }
            ],
            "actions": [
              {
                "variables": {
                  "run_seconds": "{{ [ states('sensor.smart_irrigation_front_lawn_valve_2') | float(0) | round(0) | int, 5400 ] | min }}"
                }
              },
              {
                "action": "switch.turn_on",
                "target": {
                  "entity_id": "switch.tze284_8zizsafo_ts0601_valve_2"
                }
              },
              {
                "delay": {
                  "seconds": "{{ run_seconds }}"
                }
              },
              {
                "action": "switch.turn_off",
                "target": {
                  "entity_id": "switch.tze284_8zizsafo_ts0601_valve_2"
                }
              },
              {
                "action": "smart_irrigation.reset_bucket",
                "target": {
                  "entity_id": "sensor.smart_irrigation_front_lawn_valve_2"
                }
              },
              {
                "action": "notify.mobile_app_cph2655",
                "data": {
                  "title": "\u2705 Front lawn watered",
                  "message": "Ran {{ run_seconds }} s ({{ (run_seconds / 60) | round(1) }} min), Smart Irrigation calc. Bucket reset."
                }
              }
            ]
          },
          "blueprint_inputs": null,
          "context": {
            "id": "01KXFXNGXXC31BZZTN03G0GAZH",
            "parent_id": null,
            "user_id": null
          }
        },
