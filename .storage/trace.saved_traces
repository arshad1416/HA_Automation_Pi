            "action/14/then/0": [
              {
                "path": "action/14/then/0",
                "timestamp": "2026-07-10T15:15:17.717182+00:00",
                "result": {
                  "params": {
                    "domain": "notify",
                    "service": "mobile_app_cph2655",
                    "service_data": {
                      "message": "Climate AI: Set 22.5C cool Fans: kitchen=off, master=2, mina=2, guest=off, izaan=2 - Summer cooling active during mid-peak rate. High cloud cover of 78.1% triggers the rule to keep blinds open. Upstairs is warmer (23.1C perceived) than downstairs (21.9C), so ceiling fans in master, mina, and izaan are set to speed 2, and vent boosters are engaged to balance the upstairs bedrooms.",
                      "title": "Climate AI"
