                        },
                        "data": {
                          "temperature": "{{ states('input_number.airbnb_heater_temperature') | float(20) }}"
                        },
                        "continue_on_error": true
                      },
                      {
                        "action": "notify.mobile_app_cph2655",
                        "data": {
                          "message": "Airbnb safety sync: check-in day but heater was off (missed 3 PM trigger?) \u2014 re-armed to heat."
                        }
                      }
                    ]
                  }
                ]
              }
            ]
