          },
          "config": {
            "id": "house_away_mode",
            "alias": "House: Away Mode",
            "description": "Both phones away for 10 min (Arshad person + Larissa S22 SmartThings presence) -> pause Climate AI, set back the ecobee, turn off the office heater. Guards: skipped if the Family Room TV (toshiba_firetv) is on or the kitchen Nest camera saw a PERSON in the last 30 min \u2014 indoor motion sensors are cat-trippable, so only person-grade signals are used. NEVER touches the Airbnb heater (guest automations own it).",
            "mode": "single",
            "triggers": [
              {
                "trigger": "state",
                "entity_id": "person.arshad14",
                "to": "not_home",
                "for": "00:10:00"
              },
              {
                "trigger": "state",
                "entity_id": "binary_sensor.larissa_s_s22_presence",
                "to": "off",
                "for": "00:10:00"
              }
            ],
            "conditions": [
              {
                "condition": "state",
                "entity_id": "person.arshad14",
                "state": "not_home"
              },
              {
                "condition": "state",
                "entity_id": "binary_sensor.larissa_s_s22_presence",
                "state": "off"
              },
              {
                "condition": "state",
                "entity_id": "input_boolean.house_away",
                "state": "off"
              },
              {
                "condition": "template",
                "value_template": "{{ states('media_player.toshiba_firetv') in ('off', 'idle', 'standby', 'unavailable', 'unknown') }}"
              },
              {
                "condition": "template",
                "value_template": "{{ states('event.kitchen_kitchen_display_motion') in ('unknown', 'unavailable')\n   or state_attr('event.kitchen_kitchen_display_motion', 'event_type') != 'camera_person'\n   or (now() - states.event.kitchen_kitchen_display_motion.last_changed).total_seconds() > 1800 }}"
              }
            ],
            "actions": [
              {
                "action": "input_boolean.turn_on",
                "target": {
                  "entity_id": "input_boolean.house_away"
                }
              },
              {
                "action": "input_boolean.turn_off",
                "target": {
                  "entity_id": "input_boolean.climate_ai_enabled"
                }
              },
              {
                "choose": [
                  {
                    "conditions": [
                      {
                        "condition": "state",
                        "entity_id": "climate.ecobee",
                        "state": "cool"
                      }
                    ],
                    "sequence": [
                      {
                        "action": "climate.set_temperature",
                        "target": {
                          "entity_id": "climate.ecobee"
                        },
                        "data": {
                          "temperature": 26
                        }
                      }
                    ]
                  },
                  {
                    "conditions": [
                      {
                        "condition": "state",
                        "entity_id": "climate.ecobee",
                        "state": "heat"
                      }
                    ],
                    "sequence": [
                      {
                        "action": "climate.set_temperature",
                        "target": {
                          "entity_id": "climate.ecobee"
                        },
                        "data": {
                          "temperature": 18
                        }
                      }
                    ]
                  },
                  {
                    "conditions": [
                      {
                        "condition": "state",
                        "entity_id": "climate.ecobee",
                        "state": "heat_cool"
                      }
                    ],
                    "sequence": [
                      {
                        "action": "climate.set_temperature",
                        "target": {
                          "entity_id": "climate.ecobee"
                        },
                        "data": {
                          "target_temp_high": 26,
                          "target_temp_low": 18
                        }
                      }
                    ]
                  }
                ]
              },
              {
                "action": "climate.set_hvac_mode",
                "target": {
                  "entity_id": "climate.office_heater_2"
                },
                "data": {
                  "hvac_mode": "off"
                }
              },
              {
                "action": "notify.mobile_app_cph2655",
                "data": {
                  "message": "Away mode ON: Climate AI paused, ecobee set back, office heater off. Airbnb untouched."
                }
              }
            ]
          },
